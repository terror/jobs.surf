{
  "openapi": "3.1.0",
  "info": {
    "title": "jobs.surf API",
    "description": "Read-only API for aggregated job listings.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Reports whether the service and its database are healthy.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Database is unavailable"
          }
        }
      }
    },
    "/v1/jobs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Lists open jobs in newest-first order.",
        "description": "Pass `nextCursor` from a response as `cursor` and repeat the same filters to\nretrieve the next page.",
        "operationId": "listJobs",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor returned by the previous page.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of jobs to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          },
          {
            "name": "query",
            "in": "query",
            "description": "Full-text search across job titles and descriptions.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "remote",
            "in": "query",
            "description": "Whether to return only fully remote or only non-remote jobs.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "Exact source identifier to match.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Open jobs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to list jobs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Returns one open job by its jobs.surf identifier.",
        "operationId": "getJob",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Positive decimal job identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Open job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid job identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Job not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to get job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sources": {
      "get": {
        "tags": [
          "sources"
        ],
        "summary": "Lists all sources known to the database.",
        "operationId": "listSources",
        "responses": {
          "200": {
            "description": "Known job sources",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourcesResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to list sources",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable error message."
          }
        }
      },
      "JobResponse": {
        "type": "object",
        "required": [
          "applyUrl",
          "id",
          "locations",
          "sourceId",
          "title"
        ],
        "properties": {
          "applyUrl": {
            "type": "string",
            "description": "URL where candidates can apply for the job."
          },
          "descriptionHtml": {
            "type": [
              "string",
              "null"
            ],
            "description": "Sanitized HTML description supplied by the job source."
          },
          "employmentType": {
            "type": [
              "string",
              "null"
            ],
            "description": "Employment type, such as `full_time`, `part_time`, or `contract`."
          },
          "id": {
            "type": "string",
            "description": "Stable jobs.surf job identifier."
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationResponse"
            }
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "sourceId": {
            "type": "string",
            "description": "Identifier of the source that supplied the job."
          },
          "title": {
            "type": "string"
          },
          "workplace": {
            "type": [
              "string",
              "null"
            ],
            "description": "Workplace arrangement: `remote`, `hybrid`, or `on_site`."
          }
        }
      },
      "JobsResponse": {
        "type": "object",
        "required": [
          "jobs"
        ],
        "properties": {
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobResponse"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cursor for the next page, or `null` when there are no more jobs."
          }
        }
      },
      "LocationResponse": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "SourceResponse": {
        "type": "object",
        "required": [
          "adapter",
          "id",
          "organization"
        ],
        "properties": {
          "adapter": {
            "type": "string",
            "description": "Adapter used to synchronize this source."
          },
          "id": {
            "type": "string",
            "description": "Stable source identifier."
          },
          "organization": {
            "type": "string",
            "description": "Organization represented by this source."
          }
        }
      },
      "SourcesResponse": {
        "type": "object",
        "required": [
          "sources"
        ],
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceResponse"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Service health"
    },
    {
      "name": "jobs",
      "description": "Job listings"
    },
    {
      "name": "sources",
      "description": "Job sources"
    }
  ]
}
